# Git attributes for Cerberus
# ==========================
# Defines LFS tracking for large files that MUST be versioned.
# All other large binaries should be excluded by .gitignore and
# downloaded by CMake or a setup script.

# ---------------------------------------------------------------------------
# Text files — force LF line endings in repo (checkout handles conversion)
# ---------------------------------------------------------------------------
*.sh text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf

# ---------------------------------------------------------------------------
# C++ source — let Git handle line endings
# ---------------------------------------------------------------------------
*.cpp text
*.hpp text
*.h text
*.c text
*.cc text

# ---------------------------------------------------------------------------
# CMake / build scripts
# ---------------------------------------------------------------------------
CMakeLists.txt text
*.cmake text

# ---------------------------------------------------------------------------
# LFS tracked files — ONLY files that must be in git and exceed 100MB
# ---------------------------------------------------------------------------
# NOTE: GitHub LFS has bandwidth limits. Prefer .gitignore + download scripts.
# If you add a file here, also document it in docs/dependencies.md

# Example (commented out — prefer external download):
# third_party/onnxruntime/**/*.dll filter=lfs diff=lfs merge=lfs -text

# ---------------------------------------------------------------------------
# Binary files — do not diff, do not merge
# ---------------------------------------------------------------------------
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.tar.gz binary
*.7z binary
