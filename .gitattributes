# ===========================================================================
# Git LFS tracking — Cerberus heterogeneous inference runtime
# ===========================================================================
# Binary artefacts that would bloat the repo if stored in git objects.
# LFS stores a pointer file in git, with the real content on GitHub/GitLab.
# ===========================================================================

# --- ORT SDK & runtime libraries ---
*.dll     filter=lfs diff=lfs merge=lfs -text
*.lib     filter=lfs diff=lfs merge=lfs -text
*.so      filter=lfs diff=lfs merge=lfs -text
*.dylib   filter=lfs diff=lfs merge=lfs -text

# --- EXPLICITLY EXCLUDE debug symbols (200-350 MB each, GitHub rejects >100MB) ---
*.pdb     -filter=lfs diff=lfs merge=lfs -text
ort/lib/*.pdb  -filter=lfs diff=lfs merge=lfs -text

# --- Archives (toolchains, model weights, datasets) ---
*.7z      filter=lfs diff=lfs merge=lfs -text
*.zip     filter=lfs diff=lfs merge=lfs -text
*.tar     filter=lfs diff=lfs merge=lfs -text
*.tar.gz  filter=lfs diff=lfs merge=lfs -text
*.tar.xz  filter=lfs diff=lfs merge=lfs -text
*.tgz     filter=lfs diff=lfs merge=lfs -text

# --- ONNX model files ---
*.onnx    filter=lfs diff=lfs merge=lfs -text
*.ort     filter=lfs diff=lfs merge=lfs -text

# --- Hailo model files ---
*.hef     filter=lfs diff=lfs merge=lfs -text

# --- Images & documents ---
*.png     filter=lfs diff=lfs merge=lfs -text
*.jpg     filter=lfs diff=lfs merge=lfs -text
*.jpeg    filter=lfs diff=lfs merge=lfs -text
*.gif     filter=lfs diff=lfs merge=lfs -text
*.svg     filter=lfs diff=lfs merge=lfs -text
*.ico     filter=lfs diff=lfs merge=lfs -text
*.pdf     filter=lfs diff=lfs merge=lfs -text
*.docx    filter=lfs diff=lfs merge=lfs -text
*.doc     filter=lfs diff=lfs merge=lfs -text

# --- Build artefacts (compiled objects, archives) ---
*.exe     filter=lfs diff=lfs merge=lfs -text
*.a       filter=lfs diff=lfs merge=lfs -text
*.o       filter=lfs diff=lfs merge=lfs -text
*.obj     filter=lfs diff=lfs merge=lfs -text

# --- Windows Zone.Identifier alternate data streams — never track ---
*Zone.Identifier merge=binary -text -diff
