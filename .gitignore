# Cerberus Build & Dependency Management
# ======================================
# This file protects the repository from build artifacts, downloaded binaries,
# and platform-specific files that should never be committed.
#
# NOTE: ONNX Runtime binaries are downloaded by CMake or a setup script.
#       Do NOT commit .zip files, .pdb debug symbols, or extracted DLLs.
#       See: third_party/onnxruntime/.download-marker

# ---------------------------------------------------------------------------
# Build artifacts — all build directories
# ---------------------------------------------------------------------------
build/
code/build/
code/build-*/
code/build_*/
!code/build/.gitkeep
!code/build_*/.gitkeep
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
compile_commands.json
*.ninja
.ninja_deps
.ninja_log

# ---------------------------------------------------------------------------
# Compiled outputs
# ---------------------------------------------------------------------------
*.exe
*.dll
*.lib
*.a
*.so
*.dylib
*.obj
*.o
*.pdb
*.ilk
*.exp
*.manifest
*.res

# ---------------------------------------------------------------------------
# ONNX Runtime — downloaded/staged binaries (NOT source code)
# ---------------------------------------------------------------------------
# The .zip distribution package (downloaded from Microsoft/GitHub releases)
third_party/onnxruntime/*.zip
third_party/onnxruntime/**/*.zip

# Debug symbols (huge, platform-specific, recreatable)
third_party/onnxruntime/**/*.pdb

# Extracted DLLs — these are copied to build output by CMake POST_BUILD
# The headers and .lib import libraries ARE kept (needed for linking)
third_party/onnxruntime/**/*.dll

# Download marker (generated by setup script to track version)
third_party/onnxruntime/.download-marker

# Alternative ort/ directory (legacy staging area)
ort/*.dll
ort/**/*.pdb

# ---------------------------------------------------------------------------
# Test & debug output
# ---------------------------------------------------------------------------
*.log
propup_*.txt
propup_out*.txt
smoke_debug_log.txt
propup_run*.txt
propup_latest_*.txt
full_propup_out.txt
full_run.txt
out.txt
out_check.txt
bisect_*.cpp
test_*.cpp
test_*.txt

# ---------------------------------------------------------------------------
# IDE & editor
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
*.bak
*.bak2
*.bak3
*.orig

# ---------------------------------------------------------------------------
# OS files
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db

# ---------------------------------------------------------------------------
# Python / package manager
# ---------------------------------------------------------------------------
__pycache__/
*.pyc
*.pyo
node_modules/

# ---------------------------------------------------------------------------
# LFS pointer files that should stay local
# ---------------------------------------------------------------------------
# (If LFS is used, pointers are tracked; actual objects are not)

# vendored onnxruntime binaries: too large for git (stripped from branch history 05/09/2026)
third_party/onnxruntime/

# vendored onnxruntime binaries: too large for git (stripped from branch history 05/09/2026)
third_party/onnxruntime/
