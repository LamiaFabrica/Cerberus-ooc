# ===========================================================================
# .gitignore — Cerberus heterogeneous inference runtime
# ===========================================================================
# Build outputs (generated by CMake / build.py)
# NOTE: We deliberately list every known build tree variant because people (and agents)
# keep creating new ones (build_debug, build-wsl from WSL, build_linux, build_fresh, etc.).
# Any new build tree must be added here immediately per GIT_WORKFLOW_POLICY.md.
build/
build_r*/
code/build/
code/build_r*/
code/build-*/
code/build_*/
code/build_linux/
code/build_debug/
code/build_fresh/
code/build_r7/
code/build-wsl/
cmake-build-*/

# IDE / editor cruft
.vs/
.vscode/
.idea/
*.suo
*.user
*.sln
*.vcxproj*
CMakeSettings.json
compile_commands.json

# OS junk
.DS_Store
Thumbs.db
desktop.ini
*.tmp
*.bak
*.bak2
*.swp
*~

# Python cache
__pycache__/
*.pyc
*.pyo

# Windows Zone.Identifier — never track NTFS alternate data streams
*:Zone.Identifier
*Zone.Identifier

# Development docs — internal only, not for public repo
Development docs/

# LFSSL bridge build artifacts
lfssl_bridge/obj/
lfssl_bridge/tests/*.exe

# Temporary / scratch directories
New folder/
doc/

# Binary archives that are LFS-tracked (downloaded, not committed directly)
gcc-*/

# ONNX Runtime debug symbols — massive (200–350 MB each), never commit
ort/lib/*.pdb

# Obsolete local test / battle reports (replaced by research/ reports)
*Agent*Battle*
*Battle*Test*Report*

# ===========================================================================
# Grok Build session artifacts (NEVER pollute main tree — all new files
# created during this session must be ignored until explicit review)
# ===========================================================================
grok_*/
grok-*/
*.grok.*
grok_work/
grok_temp/
grok_output/
# Any packaging/installer artifacts I generate during this session
installer/grok_*
Cerberus-*-Grok-*.exe
Cerberus-*-Grok-*.zip
# Temporary benchmark or NPU trace outputs
*.npu_bench.json
*.npu_trace.log

# Hermes agent internal tracking (kanban boards, plans, etc.)
.hermes/
