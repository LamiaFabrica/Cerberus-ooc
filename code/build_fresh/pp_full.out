class SHA256 {
private:
    static constexpr uint32_t K[64] = {
        0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5,
        0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
        0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3,
        0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
        0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc,
        0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
        0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7,
        0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
        0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13,
        0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
        0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3,
        0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
        0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5,
        0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
        0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208,
        0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2
    };

    uint32_t state[8];
    uint64_t count{0};
    uint8_t buffer[64];

    inline uint32_t rotr(uint32_t x, uint32_t n) const {
        return (x >> n) | (x << (32 - n));
    }

    inline uint32_t ch(uint32_t x, uint32_t y, uint32_t z) const {
        return (x & y) ^ (~x & z);
    }

    inline uint32_t maj(uint32_t x, uint32_t y, uint32_t z) const {
        return (x & y) ^ (x & z) ^ (y & z);
    }

    inline uint32_t sigma0(uint32_t x) const {
        return rotr(x, 2) ^ rotr(x, 13) ^ rotr(x, 22);
    }

    inline uint32_t sigma1(uint32_t x) const {
        return rotr(x, 6) ^ rotr(x, 11) ^ rotr(x, 25);
    }

    inline uint32_t gamma0(uint32_t x) const {
        return rotr(x, 7) ^ rotr(x, 18) ^ (x >> 3);
    }

    inline uint32_t gamma1(uint32_t x) const {
        return rotr(x, 17) ^ rotr(x, 19) ^ (x >> 10);
    }

    void transform(const uint8_t block[64]) {
        uint32_t W[64];
        uint32_t a, b, c, d, e, f, g, h;
        uint32_t T1, T2;


        for (int i = 0; i < 16; ++i) {
            W[i] = (block[i * 4] << 24) | (block[i * 4 + 1] << 16) |
                   (block[i * 4 + 2] << 8) | (block[i * 4 + 3]);
        }
        for (int i = 16; i < 64; ++i) {
            W[i] = gamma1(W[i - 2]) + W[i - 7] + gamma0(W[i - 15]) + W[i - 16];
        }


        a = state[0];
        b = state[1];
        c = state[2];
        d = state[3];
        e = state[4];
        f = state[5];
        g = state[6];
        h = state[7];


        for (int i = 0; i < 64; ++i) {
            T1 = h + sigma1(e) + ch(e, f, g) + K[i] + W[i];
            T2 = sigma0(a) + maj(a, b, c);
            h = g;
            g = f;
            f = e;
            e = d + T1;
            d = c;
            c = b;
            b = a;
            a = T1 + T2;
        }


        state[0] += a;
        state[1] += b;
        state[2] += c;
        state[3] += d;
        state[4] += e;
        state[5] += f;
        state[6] += g;
        state[7] += h;
    }

public:
    static constexpr size_t DIGEST_SIZE = 32;

    SHA256() {
        reset();
    }

    void reset() {

        state[0] = 0x6a09e667;
        state[1] = 0xbb67ae85;
        state[2] = 0x3c6ef372;
        state[3] = 0xa54ff53a;
        state[4] = 0x510e527f;
        state[5] = 0x9b05688c;
        state[6] = 0x1f83d9ab;
        state[7] = 0x5be0cd19;
        count = 0;
        std::memset(buffer, 0, sizeof(buffer));
    }

    void update(const uint8_t* data, size_t length) {
        size_t buffer_space = 64 - (count % 64);

        count += length;

        if (length >= buffer_space) {
            std::memcpy(buffer + (64 - buffer_space), data, buffer_space);
            transform(buffer);
            data += buffer_space;
            length -= buffer_space;

            while (length >= 64) {
                transform(data);
                data += 64;
                length -= 64;
            }

            buffer_space = 64;
        }

        std::memcpy(buffer + (64 - buffer_space), data, length);
    }

    void finalize(uint8_t digest[DIGEST_SIZE]) {
        uint8_t padding[64];
        uint64_t bit_length = count * 8;
        size_t padding_length{0};


        padding[0] = 0x80;
        if ((count % 64) < 56) {
            padding_length = 56 - (count % 64);
        } else {
            padding_length = 64 + 56 - (count % 64);
        }

        std::memset(padding + 1, 0, padding_length - 1);
        update(padding, padding_length);


        for (int i = 0; i < 8; ++i) {
            padding[7 - i] = (bit_length >> (i * 8)) & 0xFF;
        }
        update(padding, 8);


        for (int i = 0; i < 8; ++i) {
            digest[i * 4] = (state[i] >> 24) & 0xFF;
            digest[i * 4 + 1] = (state[i] >> 16) & 0xFF;
            digest[i * 4 + 2] = (state[i] >> 8) & 0xFF;
            digest[i * 4 + 3] = state[i] & 0xFF;
        }


        reset();
    }


    static std::vector<uint8_t> hash(const uint8_t* data, size_t length) {
        SHA256 sha;
        uint8_t digest[DIGEST_SIZE];
        sha.update(data, length);
        sha.finalize(digest);
        return std::vector<uint8_t>(digest, digest + DIGEST_SIZE);
    }


    std::vector<uint8_t> hash_raw(const uint8_t* data, size_t length) {
        return hash(data, length);
    }

    static std::string hash(const std::string& data) {
        auto digest = hash(reinterpret_cast<const uint8_t*>(data.c_str()), data.length());
        return to_hex(digest.data());
    }


    static std::string to_hex(const uint8_t digest[DIGEST_SIZE]) {
        std::string result;
        result.reserve(DIGEST_SIZE * 2);
        for (size_t i = 0; i < DIGEST_SIZE; ++i) {
            char hex[3];
            snprintf(hex, sizeof(hex), "%02x", digest[i]);
            result += hex;
        }
        return result;
    }
};





class HMAC_SHA256 {
public:
    static constexpr size_t DIGEST_SIZE = 32;
    static constexpr size_t BLOCK_SIZE = 64;

    static void compute(const uint8_t* key, size_t key_len,
                       const uint8_t* data, size_t data_len,
                       uint8_t digest[DIGEST_SIZE]) {
        uint8_t k_ipad[BLOCK_SIZE];
        uint8_t k_opad[BLOCK_SIZE];
        uint8_t key_hash[DIGEST_SIZE];


        if (key_len > BLOCK_SIZE) {
            SHA256 sha;
            sha.update(key, key_len);
            sha.finalize(key_hash);
            key = key_hash;
            key_len = DIGEST_SIZE;
        }


        std::memset(k_ipad, 0x36, BLOCK_SIZE);
        std::memset(k_opad, 0x5c, BLOCK_SIZE);
        for (size_t i = 0; i < key_len; i++) {
            k_ipad[i] ^= key[i];
            k_opad[i] ^= key[i];
        }


        SHA256 sha_inner;
        sha_inner.update(k_ipad, BLOCK_SIZE);
        sha_inner.update(data, data_len);
        uint8_t inner_hash[DIGEST_SIZE];
        sha_inner.finalize(inner_hash);

        SHA256 sha_outer;
        sha_outer.update(k_opad, BLOCK_SIZE);
        sha_outer.update(inner_hash, DIGEST_SIZE);
        sha_outer.finalize(digest);
    }
};






class PBKDF2_SHA256 {
public:
# 333 "C:/MCMAKE~1/Projects/PSIFOR~4/Src/Inc/Intake/include/lfssl/LFSSL_Native_Crypto.hpp" 3 4
    static void derive(const uint8_t* password, size_t password_len,
                      const uint8_t* salt, size_t salt_len,
                      int iterations, size_t dk_len,
                      uint8_t* derived_key) {
        const size_t hLen = 32;
        size_t l = (dk_len + hLen - 1) / hLen;

        for (size_t block = 1; block <= l; block++) {
            uint8_t U[32];
            uint8_t T[32];
            std::memset(T, 0, 32);


            std::vector<uint8_t> block_data(salt, salt + salt_len);
            block_data.push_back((block >> 24) & 0xFF);
            block_data.push_back((block >> 16) & 0xFF);
            block_data.push_back((block >> 8) & 0xFF);
            block_data.push_back(block & 0xFF);

            HMAC_SHA256::compute(password, password_len,
                               block_data.data(), block_data.size(), U);
            std::memcpy(T, U, 32);


            for (int i = 1; i < iterations; i++) {
                HMAC_SHA256::compute(password, password_len, U, 32, U);
                for (size_t j = 0; j < 32; j++) {
                    T[j] ^= U[j];
                }
            }


            size_t offset = (block - 1) * hLen;
            size_t copy_len = (dk_len - offset < hLen) ? (dk_len - offset) : hLen;
            std::memcpy(derived_key + offset, T, copy_len);
        }
    }




    static std::string derive_hex(const std::string& password,
                                  const std::string& salt_hex,
                                  int iterations = 100000,
                                  size_t dk_len = 64) {

        std::vector<uint8_t> salt_bytes;
        for (size_t i = 0; i < salt_hex.length(); i += 2) {
            std::string byte_str = salt_hex.substr(i, 2);
            salt_bytes.push_back((uint8_t)std::stoul(byte_str, nullptr, 16));
        }


        std::vector<uint8_t> derived(dk_len);
        derive(reinterpret_cast<const uint8_t*>(password.c_str()), password.length(),
              salt_bytes.data(), salt_bytes.size(),
              iterations, dk_len, derived.data());


        std::string result;
        result.reserve(dk_len * 2);
        for (size_t i = 0; i < dk_len; ++i) {
            char hex[3];
            snprintf(hex, sizeof(hex), "%02x", derived[i]);
            result += hex;
        }
        return result;
    }
};







class SHA384 {
public:
    static constexpr size_t DIGEST_SIZE = 48;




