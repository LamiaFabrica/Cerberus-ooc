[[nodiscard]] inline std::uint64_t fnv1a_bytes(const void* data, std::size_t n) noexcept {
    std::uint64_t hash = 0xcbf29ce484222325ull;
    const auto* ptr = static_cast<const std::uint8_t*>(data);
